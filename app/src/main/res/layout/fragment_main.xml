<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <include
            android:id="@+id/list_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            layout="@layout/layout_item"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/counter"
            android:layout_below="@+id/list_title"
            android:layout_alignTop="@+id/list_title"
            android:layout_alignParentEnd="true"
            android:text="0/0"
            android:paddingEnd="4dp"
            android:textColor="@color/color_label"
            />
        <ListView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/list_view"
            android:overScrollMode="never"
            android:divider="@null"
            android:layout_below="@+id/list_title"
            android:clipToPadding="false"
            android:scrollbarThumbVertical="@drawable/scroll_vertical"
            />
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_marginBottom="-9dp"
            android:layout_alignParentBottom="true"
            android:visibility="gone"
            tools:visibility="visible"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/flash"
            android:background="@color/colorFlash"
            android:visibility="gone"
            />
        <LinearLayout
            android:id="@+id/permission_disclaimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:padding="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/disclaimer"
            tools:visibility="visible"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/need_location_permission"
                android:textSize="16sp"
                android:gravity="center"
                android:maxWidth="240sp"
                />
            <Button
                android:id="@+id/btn_grant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Widget.AppCompat.Button.Colored"
                android:text="@string/grant"
                />
        </LinearLayout>
    </RelativeLayout>
    <include
        android:id="@+id/bottom_toolbar"
        layout="@layout/layout_buttons_pane"
        />
</FrameLayout>
