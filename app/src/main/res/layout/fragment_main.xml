<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface"
    android:orientation="vertical"
    >
    <include
        layout="@layout/app_bar"
        android:id="@+id/app_bar"
        />
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?colorSurface"
        >
        <RelativeLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <include
                layout="@layout/item_point"
                android:id="@+id/list_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                />
            <include
                layout="@layout/point_counter"
                android:id="@+id/counters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_below="@+id/list_title"
                android:layout_alignTop="@+id/list_title"
                android:layout_alignParentEnd="true"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/list_title"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                android:scrollbarThumbVertical="@drawable/scroll_vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/flash"
                android:background="@color/colorFlash"
                android:visibility="gone"
                />
            <LinearLayout
                android:id="@+id/permission_disclaimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:padding="@dimen/padding_common"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/disclaimer"
                tools:visibility="visible"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/need_location_permission"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:maxWidth="240sp"
                    />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_grant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_half"
                    app:cornerRadius="@dimen/button_corner"
                    android:text="@string/grant"
                    />
            </LinearLayout>
        </RelativeLayout>
        <include
            layout="@layout/bottom_bar"
            android:id="@+id/bottom_toolbar"
            />
        <ru.raslav.wirelessscan.ui.view.HeaderDropdownLayout
            android:id="@+id/periods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurfaceContainer"
            android:paddingBottom="@dimen/padding_half"
            tools:layout_marginTop="128dp"
            />
    </FrameLayout>
</LinearLayout>
